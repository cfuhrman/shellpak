# -*- mode: conf -*-
#
# Configuration file for nano(1)
#
# Created Sun Apr 15 13:17:07 2018 PDT
#

set backup
set breaklonglines
set fill 100
set regexp
set speller aspell
set tabstospaces
set unix

# Colors
set titlecolor     brightwhite,red
set statuscolor    brightwhite,red
set errorcolor     red,white
set keycolor       brightwhite,red
set functioncolor  brightwhite,black

# Syntax Highlighting
include "~/SHELL/thirdparty/nano/csharp.nanorc"
include "~/SHELL/thirdparty/nano/gitcommit.nanorc"
include "~/SHELL/thirdparty/nano/git.nanorc"
include "~/SHELL/thirdparty/nano/lisp.nanorc"
include "~/SHELL/thirdparty/nano/markdown.nanorc"
include "~/SHELL/thirdparty/nano/powershell.nanorc"
include "~/SHELL/thirdparty/nano/sh.nanorc"
include "~/SHELL/thirdparty/nano/svn.nanorc"
