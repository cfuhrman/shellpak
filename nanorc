set breaklonglines
set fill 100
set regexp
set speller aspell
set tabstospaces
set unix

# Colors
set titlecolor     brightwhite,red
set statuscolor    brightwhite,red
set errorcolor     red,white
set keycolor       brightwhite,red
set functioncolor  brightwhite,black

# Syntax Highlighting
include "/usr/share/nano/default.nanorc"
include "/usr/share/nano/elisp.nanorc"
include "/usr/share/nano/git.nanorc"
include "/usr/share/nano/java.nanorc"
include "/usr/share/nano/makefile.nanorc"
include "/usr/share/nano/markdown.nanorc"
include "/usr/share/nano/nanohelp.nanorc"
include "/usr/share/nano/nanorc.nanorc"
include "/usr/share/nano/patch.nanorc"
include "/usr/share/nano/perl.nanorc"
include "/usr/share/nano/sh.nanorc"
include "/usr/share/nano/sql.nanorc"
include "/usr/share/nano/xml.nanorc"
include "/usr/share/nano/yaml.nanorc"
